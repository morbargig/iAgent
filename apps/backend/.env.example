# ============================================
# iAgent Backend - Environment Variables
# ============================================
# Copy this file to .env and fill in your actual values
# NEVER commit the .env file to version control
# ============================================

# Server Configuration
PORT=3030
NODE_ENV=development

# Application URLs
API_URL=http://localhost:3030/api
FRONTEND_URL=http://localhost:3000

# CORS (comma-separated origins; regex supported as /pattern/)
# FRONTEND_URL, API_URL, and RENDER_EXTERNAL_URL are also included automatically
CORS_ORIGINS=http://localhost:3000,http://localhost:3030,http://localhost:4200,http://localhost:4300

# Production example:
# FRONTEND_URL=https://morbargig.github.io/iAgent/
# CORS_ORIGINS=https://morbargig.github.io,https://bargigsoftwar.github.io,https://iagent-k0dx.onrender.com

# ============================================
# MongoDB Configuration (REQUIRED)
# ============================================
# Remote MongoDB connection string
# Format: mongodb+srv://username:password@cluster.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=your_mongodb_connection_string_here
DB_NAME=filesdb
JWT_SECRET=your_jwt_secret_here
